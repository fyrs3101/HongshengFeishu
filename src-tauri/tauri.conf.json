{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "鸿升飞书",
  "version": "1.3.1",
  "identifier": "com.hongsheng.feishu",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "鸿升飞书",
        "width": 920,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "鸿升飞书 · 局域网即时通讯与文件传输",
    "longDescription": "鸿升飞书是一款面向局域网的即时通讯与文件传输工具，自动发现网段内同事、点对点收发消息与文件，无需服务器。版权所有：鸿升周老师。",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {}
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
